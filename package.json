{
  "name": "api-performance-suite",
  "version": "1.0.0",
  "description": "API, contract (OpenAPI + ajv) and K6 load tests against restful-booker, with a K6 trend history on GitHub Pages.",
  "type": "module",
  "scripts": {
    "test:api": "playwright test tests/api",
    "test:contract": "playwright test tests/contract",
    "test": "playwright test",
    "lint:contract": "npx --yes @redocly/cli@2.77.0 lint openapi.yaml",
    "report": "playwright show-report",
    "api:up": "docker run -d --rm --name restful-booker -p 3001:3001 mwinteringham/restfulbooker@sha256:a87ae093264caf64cad2557256921cbdb1fec466d6356b5e140e3f060b904f04 && scripts/wait-for-api.sh http://localhost:3001",
    "api:down": "docker stop restful-booker",
    "perf:smoke": "mkdir -p results && k6 run --summary-export=results/smoke.json k6/smoke.js",
    "perf:load": "mkdir -p results && k6 run --summary-export=results/load.json k6/load.js",
    "perf:spike": "mkdir -p results && k6 run --summary-export=results/spike.json k6/spike.js",
    "perf:record": "node scripts/record-k6-run.mjs --results results --history results/history"
  },
  "keywords": [
    "qa",
    "api-testing",
    "performance",
    "k6",
    "playwright",
    "load-testing",
    "contract-testing",
    "openapi"
  ],
  "author": "Gabriele Scano",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.6.0",
    "yaml": "^2.9.1"
  }
}
